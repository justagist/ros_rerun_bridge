<?xml version="1.0"?>
<!-- A small arm from primitive shapes: a turntable, an elbow and a two-finger gripper. The right finger mimics the left
     one, mirrored. -->
<robot name="example_arm">
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.9 1"/></material>
  <material name="orange"><color rgba="0.95 0.55 0.1 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.12" length="0.1"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0.2"/>
      <geometry><box size="0.08 0.08 0.4"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <link name="forearm">
    <visual>
      <origin xyz="0.15 0 0"/>
      <geometry><box size="0.3 0.06 0.06"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  <link name="finger_left">
    <visual>
      <origin xyz="0.04 0 0"/>
      <geometry><box size="0.08 0.015 0.04"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <link name="finger_right">
    <visual>
      <origin xyz="0.04 0 0"/>
      <geometry><box size="0.08 0.015 0.04"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="turntable" type="revolute">
    <parent link="base_link"/><child link="upper_arm"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.4"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="1"/>
  </joint>
  <joint name="finger_left_joint" type="prismatic">
    <parent link="forearm"/><child link="finger_left"/>
    <origin xyz="0.3 0 0"/><axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" effort="1" velocity="0.1"/>
  </joint>
  <joint name="finger_right_joint" type="prismatic">
    <parent link="forearm"/><child link="finger_right"/>
    <origin xyz="0.3 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-0.03" upper="0.0" effort="1" velocity="0.1"/>
    <mimic joint="finger_left_joint" multiplier="-1"/>
  </joint>
</robot>
